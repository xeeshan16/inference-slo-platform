# A local multi-node Kubernetes cluster (Kubernetes-in-Docker).
# Worker nodes let the PodDisruptionBudget, topology spread and rolling
# restarts behave like they would on a real cluster.
resource "kind_cluster" "this" {
  name           = var.name
  node_image     = var.node_image
  wait_for_ready = true

  kind_config {
    kind        = "Cluster"
    api_version = "kind.x-k8s.io/v1alpha4"

    node {
      role = "control-plane"
    }

    dynamic "node" {
      for_each = range(var.worker_count)
      content {
        role = "worker"
      }
    }
  }
}
