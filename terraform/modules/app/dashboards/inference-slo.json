    {
      "type": "timeseries",
      "title": "Request rate per pod",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (k8s_pod_name) (rate(inference_request_duration_seconds_count{route=\"/predict\"}[1m]))",
          "legendFormat": "{{k8s_pod_name}}",
